########## Web application
APP_HOST=127.0.0.1
APP_PORT=8888

# Theme the interface starts with: 'auto', 'light' or 'dark'
DEFAULT_THEME=auto

# Used to sign the session cookie that carries flash messages.
# Generate your own: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=170028c332538b218c7824e4eb15155c1a0d702c34d9695609d6b6627d2567c7

# Log detail: DEBUG, INFO, WARNING, ERROR. Overrides the value in app.yaml.
LOG_LEVEL=INFO

# IMPORTANT: set your local time zone - every timestamp in the logs and in the
# result log files follows it (e.g. Europe/Kyiv, Europe/Warsaw, Asia/Yerevan, etc).
TZ=Europe/Kyiv

# Paths inside the container. Override them only for a local run without Docker.
LOG_DIR=/logs
DATA_DIR=/data

########## SOAX
SOAX_HOST=proxy.soax.com
SOAX_PORT=1337

# REQUIRED. The 'Package password' from the SOAX dashboard, Settings tab.
# Without it the application starts but refuses to run checks: the gateway
# would reject every single one of them.
# Keep it here and nowhere else - app.yaml is editable through the Settings
# page and rendered into the browser.
SOAX_PACKAGE_PASSWORD=PACKAGE_PASSWORD

# The package UUID from the same tab. Not part of the connection string.
SOAX_PACKAGE_ID=PACKAGE_ID

########## Performance
#
# These are deliberately conservative. Raise them only if you know what the
# machine can take: each screenshot starts its own Chromium.
MAX_CONCURRENCY=4
MAX_SCREENSHOT_WORKERS=1
CHECK_TIMEOUT_SEC=60
SCREENSHOT_TIMEOUT_SEC=30
# Extra wait after the page has loaded, for sites that render themselves in JS
SCREENSHOT_WAIT_AFTER_LOAD_SEC=20

########## Optional overrides for data/config/app.yaml
#
# Anything set here wins over the file. Leave a line commented out to let
# app.yaml decide.

# Transport the forms preselect: http | socks5. Unset means no default at all,
# and then the transport has to be chosen explicitly for every run.
# SOAX_TRANSPORT=http

# task = one SOAX session per checked site, geo = one session per country
# SOAX_SESSION_SCOPE=task

# How the gateway handles a bad exit node: replace | retry | fail
# SOAX_ON_ERROR=retry
# SOAX_ON_ERROR_RETRIES=3

# Resolve the exit IP and real location of each session before checking
# SOAX_PREFLIGHT=true

# Pre-run check that the proxy service is reachable at all
# ALIVE_CHECK_ENABLED=true
# ALIVE_CHECK_TARGETS=http://example.com,http://detectportal.firefox.com/success.txt,http://cloudflare.com/cdn-cgi/trace
# ALIVE_CHECK_REQUIRED_OK=2
# ALIVE_CHECK_TIMEOUT_SEC=10

# Allow IPv6 for every name this application resolves. The SOAX gateway does
# not route IPv6, so leaving it off keeps a guaranteed failure from looking
# like an unavailable mirror.
# DNS_USE_IPV6=false

########## Gunicorn (read by docker/gunicorn.conf.py)

# GUNICORN_WORKERS=4
# Kills a worker that has not reported for this long. Not a limit on how long a
# check may take - a slow screenshot does not count against it.
# GUNICORN_TIMEOUT=180
# GUNICORN_GRACEFUL_TIMEOUT=30
# Reload the application when a source file changes. Useful while developing,
# and it will interrupt a run in progress.
# GUNICORN_RELOAD=true
