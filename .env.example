APP_HOST=127.0.0.1
APP_PORT=8888
# DEFAULT_THEME -- 'auto', 'light' or 'dark'
DEFAULT_THEME=auto
SECRET_KEY=170028c332538b218c7824e4eb15155c1a0d702c34d9695609d6b6627d2567c7

# Logger detail level (DEBUG, INFO, WARNING, ERROR)
# Overrides the value in app.yaml
LOG_LEVEL=INFO

# IMPORTANT: Set your local time zone
# (например, Europe/Kiev, Europe/Berlin, Asia/Tashkent)
TZ=Europe/Kyiv

# Default paths for local (ad-hoc) run.
# For Docker, entrypoint.sh provides /data and /logs
LOG_DIR=/logs
DATA_DIR=/data

MAX_CONCURRENCY=4
MAX_SCREENSHOT_WORKERS=1
CHECK_TIMEOUT_SEC=60
SCREENSHOT_TIMEOUT_SEC=30
# Forced delay AFTER page load (for SPA)
SCREENSHOT_WAIT_AFTER_LOAD_SEC=20

# SOAX
SOAX_HOST=proxy.soax.com
SOAX_PORT=1337
SOAX_PACKAGE_PASSWORD=PACKAGE_PASSWORD
SOAX_PACKAGE_ID=PACKAGE_ID

# Optional overrides for data/config/app.yaml:
# SOAX_SESSION_SCOPE=task
# Default transport the forms preselect: http | socks5. Leave unset to have no
# default at all - then the transport must be chosen explicitly for every run.
# SOAX_TRANSPORT=http
# SOAX_ON_ERROR=retry
# SOAX_ON_ERROR_RETRIES=3
# SOAX_PREFLIGHT=true
